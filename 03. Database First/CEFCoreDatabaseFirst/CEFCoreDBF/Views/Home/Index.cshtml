@*Se accede al modelo categoría *@
@model IEnumerable<CEFCoreDBF.Models.categoria>

@{
    ViewData["Title"] = "Home Page";
}

<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Activo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.idcategoria</td>
                <td>@item.nombre</td>
                <td>@item.descripcion</td>
                <td>@item.activo</td>
            </tr>
        }
    </tbody>
</table>
