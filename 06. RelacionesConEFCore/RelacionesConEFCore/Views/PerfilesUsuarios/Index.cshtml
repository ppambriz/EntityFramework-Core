@model IEnumerable<RelacionesConEFCore.Models.PerfilUsuario>

@{
    ViewData["Title"] = "Perfiles de Usuario";
}

<h1 class="mb-4">Perfiles de Usuario</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Nuevo Perfil</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.UsuarioId)</th>
            <th>Usuario</th>
            <th>@Html.DisplayNameFor(model => model.Biografia)</th>
            <th>@Html.DisplayNameFor(model => model.FotoUrl)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UsuarioId</td>
                <td>@item.Usuario?.Nombre</td>
                <td>@item.Biografia</td>
                <td>@item.FotoUrl</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.UsuarioId" class="btn btn-sm btn-warning">Editar</a>
                  @*   <a asp-action="Detalle" asp-route-id="@item.UsuarioId" class="btn btn-sm btn-info">Detalles</a> *@
                    <a asp-action="Borrar" asp-route-id="@item.UsuarioId" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>