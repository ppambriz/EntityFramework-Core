@model RelacionesConEFCore.Models.Etiqueta

@{
    ViewData["Title"] = "Nueva Etiqueta";
}

<h2 class="mb-4">Nueva Etiqueta</h2>

<form asp-action="Crear" method="POST" class="mt-3">

    <!-- Aquí se muestran los errores de validación generales y de propiedades -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Ingresa el nombre de la etiqueta" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}