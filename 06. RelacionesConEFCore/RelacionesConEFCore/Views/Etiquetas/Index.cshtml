@model IEnumerable<RelacionesConEFCore.Models.Etiqueta>

@{
    ViewData["Title"] = "Etiquetas";
}

<h1 class="mb-4">Etiquetas</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Nueva Etiqueta</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>Artículos Usando la Etiqueta</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>             
                <td>@item.Nombre</td>             
                <td>
                    @if (item.Articulos != null && item.Articulos.Any())
                    {
                        @string.Join(", ", item.Articulos.Select(e => e.Titulo))
                    }
                    else
                    {
                        <span class="text-muted">Sin artículos</span>
                    }
                </td>            
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Borrar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>