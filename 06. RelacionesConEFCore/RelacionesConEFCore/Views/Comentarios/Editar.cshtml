@model RelacionesConEFCore.Models.Comentario

@{
    ViewData["Title"] = "Editar Comentario";
}

<h2 class="mb-4">Editar Comentario</h2>
<hr />

<form asp-action="Editar" method="POST" class="mt-3">


    <!-- Aquí se muestran los errores de validación generales y de propiedades -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Texto" class="form-label"></label>
        <input asp-for="Texto" class="form-control" placeholder="Ingresa el nombre del artículo" />
        <span asp-validation-for="Texto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <select asp-for="UsuarioId" class="form-select"
                asp-items="ViewBag.Usuarios">
            <option value="">--Seleccione un Usuario--</option>
        </select>
        <span asp-validation-for="UsuarioId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Artículo</label>
        <select asp-for="ArticuloId" class="form-select"
                asp-items="ViewBag.Articulos">
            <option value="">--Seleccione un Artículo--</option>
        </select>
        <span asp-validation-for="ArticuloId" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <input asp-for="Aprobado" class="form-check-input" type="checkbox" />
        <label asp-for="Aprobado" class="form-label"></label>
    </div>


    <button type="submit" class="btn btn-success">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}