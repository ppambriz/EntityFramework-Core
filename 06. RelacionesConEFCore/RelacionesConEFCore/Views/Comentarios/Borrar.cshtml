@model RelacionesConEFCore.Models.Comentario

@{
    ViewData["Title"] = "Borrar Comentario";
}


<h2 class="mb-4">Borrar Comentario</h2>

<div class="alert alert-warning">
    <h5>¿Estás seguro que deseas eliminar este comentario?</h5>
</div>

<div class="card">
    <div class="card-body">
        <p><strong>Texto: </strong>@Model.Texto</p>
        <p><strong>Usuario: </strong>@(Model.Usuario != null ? Model.Usuario.Nombre : "No asignado")</p>
        <p><strong>Artículo: </strong>@(Model.Articulo != null ? Model.Articulo.Titulo : "No asignado")</p>
        <p><strong>Texto: </strong>@(Model.Aprobado ? "Sí" : "No")</p>
    </div>
</div>

<form asp-action="Borrar">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn  btn-danger">Borrar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>